# Copie este archivo a .env y ajuste los valores. No incluya secretos reales en el repositorio.

# Clave secreta (obligatoria en producción; en desarrollo hay un valor por defecto)
SECRET_KEY=cambie-esta-clave-por-una-larga-y-aleatoria
# Modo depuración (solo desarrollo)
DEBUG=True
# Hosts permitidos, separados por coma
ALLOWED_HOSTS=localhost,127.0.0.1
# Base de datos (por defecto SQLite en la raíz). Ejemplo PostgreSQL:
# DATABASE_URL=postgres://usuario:clave@localhost:5432/regicont
DATABASE_URL=sqlite:///db.sqlite3
# Cuántas jugadas recientes se muestran en Digitación
FILAS_JUGADAS_HOY=10
# Cada cuántos segundos se refrescan los totales
REFRESCO_TOTALES_SEGUNDOS=7
# Solo producción: cookies seguras (requiere HTTPS)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
